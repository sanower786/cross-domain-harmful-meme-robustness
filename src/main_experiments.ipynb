# 1. STUDY OBJECTIVE
# =============================================================================

STUDY_OBJECTIVE = """
Evaluate cross-domain robustness in multimodal harmful meme understanding
when a classifier trained on one domain is evaluated on a different,
unseen domain.

The study treats CDRF as an evaluation methodology rather than as a new
prediction architecture. A common frozen multimodal representation is
used to control the representation layer while different downstream
learning strategies are evaluated under the same cross-domain protocol.
"""


